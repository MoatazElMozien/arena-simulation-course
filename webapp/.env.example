# Serverless API — copy to .env.local (dev) and set in Vercel (project → Settings → Environment Variables)

# The secret password YOU choose to open the /#/admin panel
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Upstash Redis REST credentials (free at upstash.com, or Vercel Marketplace → Upstash for Redis)
# KV_REST_API_URL / KV_REST_API_TOKEN also work as aliases (Vercel KV naming)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
